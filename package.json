{
  "name": "@zeppelinid/discord.js",
  "version": "1.0.3",
  "description": "An unofficial discord.js fork for creating selfbots",
  "main": "./src/index.js",
  "types": "./typings/index.d.ts",
  "scripts": {
    "all": "npm run build && npm publish --access public",
    "fix:all": "npm run lint:fix && npm run format",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"typings/**/*.ts\"",
    "test": "node --test",
    "build": "npm run lint:fix && npm run format && npm run test:typings && npm test",
    "test:typings": "tsc --noEmit --skipLibCheck false"
  },
  "files": [
    "src",
    "typings",
    "LICENSE-APACHE"
  ],
  "directories": {
    "lib": "src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeppelinID/discord.js.git"
  },
  "keywords": [
    "discord.js",
    "selfbot",
    "djs",
    "api",
    "bot",
    "node",
    "discord",
    "client",
    "discordapp"
  ],
  "author": "zeppelin",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/ZeppelinID/discord.js/issues"
  },
  "homepage": "https://github.com/ZeppelinID/discord.js#readme",
  "dependencies": {
    "@discordjs/collection": "^2.1.1",
    "@discordjs/formatters": "^0.6.2",
    "@sapphire/async-queue": "^1.5.5",
    "@types/ws": "^8.18.2",
    "discord-api-types": "^0.38.59",
    "impit": "^0.14.9",
    "otplib": "^13.6.0",
    "prism-media": "^1.3.5",
    "qrcode": "^1.5.4",
    "tough-cookie": "^6.1.0",
    "werift-rtp": "^0.8.9",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
